{
  "name": "hevy-mcp-unofficial",
  "version": "0.2.0",
  "description": "Unofficial MCP server for Hevy: Trainer, Coach, private mobile API and public API endpoints, with session auto-refresh",
  "type": "module",
  "bin": {
    "hevy-mcp-unofficial": "src/server.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/server.js",
    "build:endpoints": "node scripts/build-endpoints.mjs",
    "smoke": "node scripts/smoke.js",
    "prepublishOnly": "node --check src/server.js && node --check src/client.js",
    "build:payloads": "node scripts/extract-payloads.mjs",
    "build:openapi": "node scripts/extract-openapi.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "hevy",
    "trainer",
    "coach",
    "fitness",
    "workout",
    "training"
  ],
  "author": "lovelesscx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LovelessCodes/hevy-mcp-unofficial.git"
  },
  "homepage": "https://github.com/LovelessCodes/hevy-mcp-unofficial#readme",
  "bugs": {
    "url": "https://github.com/LovelessCodes/hevy-mcp-unofficial/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
